# ---------------------------------------------------------------------------
# TripSphere API — environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ---------------------------------------------------------------------------
# Database — Neon (https://console.neon.tech → your project → Connect)
#
# Neon exposes two endpoints for the same database:
#   DATABASE_URL  pooled   — host contains "-pooler". Used by the app.
#   DIRECT_URL    direct   — no "-pooler". Used by Prisma Migrate, which needs a
#                            real session that PgBouncer cannot provide.
# Both need ?sslmode=require.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Offline/local Postgres instead (docker compose up -d):
# DATABASE_URL=postgresql://tripsphere:tripsphere@localhost:5434/tripsphere?schema=public
# DIRECT_URL=postgresql://tripsphere:tripsphere@localhost:5434/tripsphere?schema=public

# ---------------------------------------------------------------------------
# Auth — generate each with: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Google sign-in (optional in dev; /auth/google returns 501 when unset)
GOOGLE_CLIENT_ID=

# CORS: comma separated origins, or * for all
CORS_ORIGINS=*

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ---------------------------------------------------------------------------
# Media — Neon Object Storage (S3-compatible, same Neon project as the DB)
#
#   neon buckets create tripsphere-media --access-level public_read
#   neon credentials create --scope storage:read --scope storage:write
#
# The endpoint is branch-scoped and shown by the create/list commands, e.g.
# https://br-winter-pond-aptw82ef.storage.c-2.us-east-2.aws.neon.tech
#
# MEDIA_DRIVER=local writes to ./uploads instead — offline development only.
# ---------------------------------------------------------------------------
# The standard AWS_* names that Neon's quickstart exports are also accepted:
#   NEON_STORAGE_ENDPOINT          <- or AWS_ENDPOINT_URL_S3
#   NEON_STORAGE_REGION            <- or AWS_REGION
#   NEON_STORAGE_ACCESS_KEY_ID     <- or AWS_ACCESS_KEY_ID      (= token_id)
#   NEON_STORAGE_SECRET_ACCESS_KEY <- or AWS_SECRET_ACCESS_KEY  (= s3_secret_access_key)
# NEON_STORAGE_* wins where both are set. Set one spelling, not both.
# NEON_STORAGE_BUCKET has no AWS_* equivalent and is always required.
MEDIA_DRIVER=neon
NEON_STORAGE_ENDPOINT=https://br-xxxx.storage.c-2.us-east-2.aws.neon.tech
NEON_STORAGE_REGION=us-east-2
NEON_STORAGE_BUCKET=tripsphere-media
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEON_STORAGE_ACCESS_LEVEL=public_read

MEDIA_MAX_FILE_SIZE_MB=10
# Only used when MEDIA_DRIVER=local
MEDIA_BASE_URL=http://localhost:3000

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Aggregate statistics: minimum experiences before averages are exposed (spec §24)
MIN_SAMPLE_SIZE=3
